START get_item

    # TODO 1: Set inventory to an empty list

        Ask the player:
        Enter the item you want to get.

    Get the player's item choice

    IF current_room is Kitchen
    AND item choice is Healing Potion

    Add "Healing Potion" to inventory

    Display You picked up the Healing Potion

    

    # TODO 2: ELSE IF current_room is "Cellar"
    AND item choice is Dragonfire Antidote

    Add "Dragonfire Antidote" to inventory

    Display "You picked up the Dragonfire Antidote."

# TODO 3:  ELSE IF current_room is "Armory"
    AND item choice is "Dragon-Slaying Sword"

    Add "Dragon-Slaying Sword" to inventory

    Display "You picked up the Dragon-Slaying Sword."

 # TODO 4: ELSE IF current_room is "Award Room"
    AND item choice is "Magic Shield"

    Add "Magic Shield" to inventory

    Display "You picked up the Magic Shield."

# TODO 5: ELSE IF current_room is "Master Bedroom"
    AND item choice is "Dragon Key"

    Add "Dragon Key" to inventory

# TODO 6:     Display "You picked up the Dragon chamber Key

   
END get_item


